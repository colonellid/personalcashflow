# Google Service Account (base64 do JSON da SA)
GOOGLE_SA_KEY_BASE64=

# Google Sheets
SHEET_ID=

# Google Drive — pastas
DRIVE_FOLDER_ID=      # pasta FATURAS (CSVs do cartão C6)
DRIVE_EXTRATOS_ID=    # pasta EXTRATOS (extratos da conta corrente C6)

# Apps Script webhook (F2)
APPS_SCRIPT_WEBHOOK_URL=    # URL "exec" da implantação do Apps Script
APPS_SCRIPT_WEBHOOK_TOKEN=  # valor de WEBHOOK_TOKEN nas propriedades do script

# UI
NEXT_PUBLIC_APP_NAME=Personal Cashflow
